<%- include('partials/head', { meta, site }) %>
<%- include('partials/header', { path, site }) %>

<main class="section article-viewer-page" data-article-viewer data-start-side="<%= article.startSide === 'left' ? 'left' : 'right' %>">
  <div class="shell article-viewer-shell">
    <header class="article-viewer-head">
      <p class="eyebrow">Статья</p>
      <h1><%= article.title %></h1>
      <% if (article.description) { %>
        <p class="article-viewer-lead"><%= article.description %></p>
      <% } %>

      <button
        type="button"
        class="article-open-btn"
        data-pdf-open
        aria-expanded="false"
        aria-controls="article-reader"
        title="Открыть просмотр"
      >
        <span class="article-open-icon" aria-hidden="true">
          <svg viewBox="0 0 64 48" width="56" height="42" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M32 8C24 8 18 10 12 14V40C18 36 24 34 32 34C40 34 46 36 52 40V14C46 10 40 8 32 8Z" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/>
            <path d="M32 8V34" stroke="currentColor" stroke-width="2.2"/>
            <path d="M20 18H26M20 24H28M38 18H44M36 24H44" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </span>
        <span class="article-open-label">Открыть статью</span>
      </button>
    </header>
  </div>

  <div
    id="article-reader"
    class="article-reader"
    data-pdf-reader
    hidden
    role="dialog"
    aria-modal="true"
    aria-label="Просмотр статьи"
  >
    <div class="article-reader-bar">
      <button type="button" class="button button-secondary" data-pdf-close>Закрыть</button>
      <span class="article-viewer-page-label" data-pdf-page-label>Разворот 1</span>
      <div class="article-reader-tools" role="toolbar" aria-label="Масштаб">
        <button type="button" class="article-tool-btn" data-pdf-zoom-out title="Уменьшить" aria-label="Уменьшить">−</button>
        <button type="button" class="article-tool-btn article-tool-btn-loupe" data-pdf-loupe title="Лупа" aria-label="Лупа" aria-pressed="false">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
            <circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="2"/>
            <path d="M15.5 15.5L21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
        <button type="button" class="article-tool-btn" data-pdf-zoom-in title="Увеличить" aria-label="Увеличить">+</button>
      </div>
    </div>

    <div class="article-reader-body">
      <button type="button" class="article-side-nav article-side-nav-prev" data-pdf-prev aria-label="Предыдущий разворот">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" aria-hidden="true">
          <path d="M15 5L8 12L15 19" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div
        class="article-viewer-stage article-viewer-stage-spread"
        data-pdf-stage
        data-stream-url="<%= streamUrl %>"
        data-view-token="<%= viewToken %>"
        tabindex="0"
      >
        <div class="article-spread" data-pdf-spread>
          <div class="article-spread-page article-spread-page-left">
            <canvas data-pdf-canvas-left></canvas>
            <div class="article-spread-blank" data-pdf-blank-left hidden></div>
          </div>
          <div class="article-spread-page article-spread-page-right">
            <canvas data-pdf-canvas-right></canvas>
            <div class="article-spread-blank" data-pdf-blank-right hidden></div>
          </div>
        </div>
        <p class="article-viewer-status" data-pdf-status>Загрузка…</p>
      </div>

      <button type="button" class="article-side-nav article-side-nav-next" data-pdf-next aria-label="Следующий разворот">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" aria-hidden="true">
          <path d="M9 5L16 12L9 19" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>
</main>

<%- include('partials/footer', { site }) %>
<script type="module" nonce="<%= cspNonce %>" src="/scripts/article-viewer.js?v=<%= assetVersion %>"></script>
</body>
</html>
