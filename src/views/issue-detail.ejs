<%- include('partials/head', { meta, site }) %>
<%- include('partials/header', { path, site }) %>
<%- include('partials/flash', { flash }) %>

<main class="section">
  <% const allMaterials = issue.materials.filter((material) => material.title); %>
  <div class="shell detail-grid">
    <div class="cover-frame">
      <img src="<%= issue.coverImage %>" alt="Обложка <%= issue.numberLabel %>" />
    </div>
    <div>
      <p class="eyebrow">Карточка выпуска</p>
      <h1><%= issue.numberLabel %></h1>
      <dl class="meta-grid meta-grid-stacked">
        <div>
          <dt>Дата выпуска</dt>
          <dd><%= dayjs(issue.publishDate).format('D MMMM YYYY') %></dd>
        </div>
        <div>
          <dt>Материалов в выпуске</dt>
          <dd><%= allMaterials.length %></dd>
        </div>
      </dl>
      <div class="detail-materials-block">
        <p class="lead">Содержание выпуска</p>
        <ul class="issue-material-list issue-material-list-detail">
          <% allMaterials.forEach((material) => { %>
            <li class="<%= material.isPrimary ? 'is-primary' : '' %>">
              <span><%= material.title %></span>
              <% if (material.isPrimary) { %>
                <span class="material-badge">Основной материал</span>
              <% } %>
            </li>
          <% }) %>
        </ul>
      </div>
      <div class="hero-actions">
        <a class="button button-accent" href="<%= site.invoiceFile || '/payment' %>" <%= site.invoiceFile ? 'target="_blank" rel="noopener"' : '' %>>Скачать счет-фактуру</a>
        <a class="button button-secondary" href="/issues">Назад к выпускам</a>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer', { site }) %>
