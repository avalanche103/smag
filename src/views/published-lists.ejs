<%- include('partials/head', { meta, site }) %>
<%- include('partials/header', { path, site }) %>
<%- include('partials/flash', { flash }) %>

<main class="section">
  <div class="shell page-head narrow-head">
    <h1>Опубликованные материалы</h1>
  </div>
  <div class="shell table-wrap">
    <table class="published-materials-table">
      <thead>
        <tr>
          <th class="col-issue">№ журнала</th>
          <th class="col-section">Рубрика</th>
          <th class="col-title">Название материала</th>
          <th class="col-author">Автор</th>
        </tr>
        <tr class="published-materials-filters">
          <td class="col-issue"><input type="text" placeholder="№" class="filter-number" aria-label="Фильтр по номеру журнала"></td>
          <td class="col-section">
            <%
              let sectionList = [];
              try {
                sectionList = getPublishedMaterialSections();
              } catch (err) {
                sectionList = [...new Set(materials.map((m) => m.section).filter((s) => s && s !== "-"))].sort((a, b) =>
                  a.localeCompare(b, "ru")
                );
              }
            %>
            <select class="filter-section" aria-label="Фильтр по рубрике">
              <option value="">Все рубрики</option>
              <% sectionList.forEach((section) => { %>
                <option value="<%= section %>"><%= section %></option>
              <% }) %>
            </select>
          </td>
          <td class="col-title"><input type="text" placeholder="Название" class="filter-title" aria-label="Фильтр по названию"></td>
          <td class="col-author"><input type="text" placeholder="Автор" class="filter-author" aria-label="Фильтр по автору"></td>
        </tr>
      </thead>
      <tbody>
        <% materials.forEach((m) => { %>
          <%
            const authors = String(m.author || '')
              .split(/\s*,\s*/)
              .map((name) => name.trim())
              .filter(Boolean);
          %>
          <tr>
            <td class="col-issue">
              <% if (m.slug) { %>
                <a href="/issues/<%= m.slug %>"><%= m.numberLabel %></a>
              <% } else { %>
                <%= m.numberLabel %>
              <% } %>
            </td>
            <td class="col-section"><%= m.section %></td>
            <td class="col-title"><%= m.title %></td>
            <td class="col-author">
              <% if (!authors.length || (authors.length === 1 && authors[0] === '-')) { %>
                -
              <% } else { %>
                <% authors.forEach((name) => { %>
                  <span class="author-line"><%= name %></span>
                <% }) %>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <% if (pagination && pagination.totalPages > 1) { %>
      <nav class="pager" aria-label="Пагинация материалов">
        <% if (pagination.currentPage > 1) { %>
          <a class="button button-secondary" href="/published-lists?page=<%= pagination.currentPage - 1 %>">Назад</a>
        <% } %>
        <span class="pager-status">Страница <%= pagination.currentPage %> из <%= pagination.totalPages %></span>
        <% if (pagination.currentPage < pagination.totalPages) { %>
          <a class="button button-secondary" href="/published-lists?page=<%= pagination.currentPage + 1 %>">Далее</a>
        <% } %>
      </nav>
    <% } %>
  </div>
</main>

<link rel="stylesheet" href="/styles/published-lists.css">
<script src="/scripts/published-lists.js" defer></script>
<%- include('partials/footer', { site }) %>
