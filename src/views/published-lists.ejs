<%- include('partials/head', { meta, site }) %>
<%- include('partials/header', { path, site }) %>
<%- include('partials/flash', { flash }) %>

<main class="section">
  <div class="shell page-head narrow-head">
    <p class="eyebrow">Материалы</p>
    <h1>Опубликованные материалы</h1>
  </div>
  <div class="shell table-wrap">
    <table>
      <thead>
        <tr>
          <th>№ журнала</th>
          <th>Рубрика</th>
          <th>Название материала</th>
          <th>Автор</th>
        </tr>
      </thead>
      <tbody>
        <% materials.forEach((m) => { %>
          <tr>
            <td><a href="/issues/<%= m.slug %>"><%= m.numberLabel %></a></td>
            <td><%= m.section %></td>
            <td><%= m.title %></td>
            <td><%= m.author %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</main>

<link rel="stylesheet" href="/styles/published-lists.css">
<script src="/scripts/published-lists.js"></script>
<%- include('partials/footer', { site }) %>
