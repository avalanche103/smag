<%- include('partials/head', { meta, site }) %>
<%- include('partials/header', { path, site }) %>
<%- include('partials/flash', { flash }) %>

<main class="section">
  <div class="shell payment-grid">
    <section>
      <h1><%= page.title %></h1>
      <div class="lead rich-content"><%- formatRichHtml(page.lead) %></div>
      <div class="rich-content"><%- formatRichHtml(site.paymentText) %></div>
      <div class="hero-actions">
        <% if (invoiceFile) { %>
          <a class="button button-accent" href="<%= invoiceFile %>" target="_blank" rel="noopener">Открыть PDF в новой вкладке</a>
          <a class="button button-secondary" href="/subscribe">Подписаться</a>
        <% } else { %>
          <a class="button button-secondary" href="/contacts">Запросить счет у редакции</a>
        <% } %>
      </div>
    </section>
    <aside class="info-panel">
      <div>
        <h2>Порядок оплаты</h2>
        <div class="rich-content"><%- formatRichHtml(page.body) %></div>
      </div>
      <div>
        <h2>Контакт по оплате</h2>
        <p><%= site.address %></p>
        <p><a href="mailto:<%= site.email %>"><%= site.email %></a></p>
        <% if (site.phone) { %>
          <p><a href="tel:<%= site.phone %>"><%= site.phone %></a></p>
        <% } %>
        <% if (site.phone2) { %>
          <p><a href="tel:<%= site.phone2 %>"><%= site.phone2 %></a></p>
        <% } %>
      </div>
      <div>
        <h2>Реквизиты</h2>
        <div class="rich-content"><%- formatRichHtml(site.requisites) %></div>
      </div>
      <div class="hotline-box">
        <p class="eyebrow">Горячая линия</p>
        <div class="rich-content"><%- formatRichHtml(site.hotlineText) %></div>
      </div>
    </aside>
  </div>
</main>

<%- include('partials/footer', { site }) %>
