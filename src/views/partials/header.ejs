<header class="site-header">
  <div class="shell header-row">
    <a class="brand" href="/">
      <span class="brand-copy" aria-label="<%= site.siteTitle %>">
        <span class="brand-line brand-line-primary">СТРОИТЕЛЬСТВО:</span>
        <span class="brand-line brand-line-secondary">ЭКОНОМИКА, УЧЕТ, ПРАВО</span>
        <span class="brand-line brand-line-tertiary">ЕЖЕМЕСЯЧНЫЙ ЖУРНАЛ ДЛЯ СПЕЦИАЛИСТОВ В СТРОИТЕЛЬНОЙ ОТРАСЛИ</span>
      </span>
    </a>

    <button class="nav-toggle" type="button" data-nav-toggle aria-label="Открыть меню">Меню</button>

    <nav class="site-nav" data-nav>
      <a href="/about" class="<%= path === '/about' ? 'is-active' : '' %>">О журнале</a>
      <a href="/issues" class="<%= path.startsWith('/issues') ? 'is-active' : '' %>">Выпуски</a>
      <a href="/published-lists" class="<%= path === '/published-lists' ? 'is-active' : '' %>">Материалы</a>
        <!-- <a href="/payment" class="<%= path === '/payment' ? 'is-active' : '' %>">Счет и оплата</a> -->
      <a href="/contacts" class="<%= path === '/contacts' ? 'is-active' : '' %>">Контакты</a>
    </nav>

      <a class="button button-accent header-cta" href="/subscribe">Подписаться</a>
  </div>
</header>
