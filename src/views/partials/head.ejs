<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= meta?.title ? `${meta.title} | ${site.siteTitle}` : site.siteTitle %></title>
    <meta name="description" content="<%= meta?.description || site.siteDescription %>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/main.css" />
    <% if (site.analyticsId) { %>
      <script async src="https://www.googletagmanager.com/gtag/js?id=<%= site.analyticsId %>"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '<%= site.analyticsId %>');
      </script>
    <% } %>
  </head>
  <body>
