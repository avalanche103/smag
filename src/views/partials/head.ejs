<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <%- include('seo-meta', { meta, site, path, cspNonce }) %>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/main.css?v=<%= assetVersion %>" />
    <% if (typeof path === 'string' && path.startsWith('/published-lists')) { %>
      <link rel="stylesheet" href="/styles/published-lists.css?v=<%= assetVersion %>" />
    <% } %>
    <% if (site.analyticsId && !(typeof path === 'string' && path.startsWith('/admin'))) { %>
      <script async src="https://www.googletagmanager.com/gtag/js?id=<%= site.analyticsId %>"></script>
      <script nonce="<%= cspNonce %>">
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '<%= site.analyticsId %>');
      </script>
    <% } %>
  </head>
  <body>
