<%- include('partials/head', { meta, site }) %>
<%- include('partials/header', { path, site }) %>
<%- include('partials/flash', { flash }) %>

<main>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <div class="hero-title rich-content"><%- formatRichHtml(getPageExtra(page, 'heroTitle')) %></div>
        <div class="hero-text rich-content"><%- formatRichHtml(getPageExtra(page, 'heroText')) %></div>
        <div class="hero-actions">
          <a class="button button-accent" href="/subscribe">Подписаться</a>
          <a class="button button-secondary" href="/issues">Смотреть выпуски</a>
        </div>
      </div>
      <div class="hero-card hero-card-white">
        <span class="eyebrow">Для кого</span>
        <% if (audienceTopics && audienceTopics.length) { %>
          <ul class="check-list">
            <% audienceTopics.forEach((topic) => { %>
              <li><%= topic %></li>
            <% }) %>
          </ul>
        <% } %>
        <% if (aboutAudienceHtml) { %>
          <div class="audience-hotline-block">
            <div class="audience-intro rich-content"><%- aboutAudienceHtml %></div>
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <% if (featuredIssue) { %>
    <% const featuredPrimaryMaterials = featuredIssue.materials.filter((material) => material.title && material.isPrimary).slice(0, 3); %>
    <% const featuredMaterials = (featuredPrimaryMaterials.length ? featuredPrimaryMaterials : featuredIssue.materials.filter((material) => material.title)).slice(0, 3); %>
    <section class="section">
      <div class="shell latest-grid">
        <div>
          <p class="eyebrow">Последний номер</p>
          <h2><%= featuredIssue.numberLabel %></h2>
          <ul class="issue-material-list issue-material-list-featured issue-material-list-accent">
            <% featuredMaterials.forEach((material) => { %>
              <li><%= material.title %></li>
            <% }) %>
          </ul>
          <div class="hero-actions">
            <a class="button button-primary" href="/issues/<%= featuredIssue.slug %>">Подробнее</a>
          </div>
        </div>
        <div class="cover-frame">
          <img src="<%= featuredIssue.coverImage %>" alt="Обложка <%= featuredIssue.numberLabel %>" />
        </div>
      </div>
    </section>
  <% } %>

  <section class="section section-muted">
    <div class="shell">
      <% const archiveIssues = (featuredIssue ? issues.filter((issue) => issue.id !== featuredIssue.id) : issues).slice(0, 3); %>
      <div class="section-head">
        <div>
          <p class="eyebrow">Анонсы и архив</p>
          <h2>Выпуски журнала</h2>
        </div>
        <a class="text-link" href="/issues">Все выпуски</a>
      </div>
      <div class="card-grid card-grid-home">
        <% archiveIssues.forEach((issue) => { %>
          <% const primaryMaterials = issue.materials.filter((material) => material.title && material.isPrimary).slice(0, 3); %>
          <% const previewMaterials = (primaryMaterials.length ? primaryMaterials : issue.materials.filter((material) => material.title)).slice(0, 3); %>
          <article class="issue-card">
            <img src="<%= issue.coverImage %>" alt="Обложка <%= issue.numberLabel %>" />
            <div class="issue-card-body">
              <span class="issue-date"><%= formatIssuePeriod(issue) %></span>
              <h3><%= issue.numberLabel %></h3>
              <ul class="issue-material-list issue-material-list-compact">
                <% previewMaterials.forEach((material) => { %>
                  <li><%= material.title %></li>
                <% }) %>
              </ul>
              <div class="issue-card-footer">
                <a class="text-link" href="/issues/<%= issue.slug %>">Подробнее</a>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="promo-block promo-block-accent hotline-promo">
        <p class="eyebrow">Горячая линия</p>
        <h2>Эксклюзивно для подписчиков журнала работает горячая линия</h2>
        <p class="hotline-promo-lead">
          Получите оперативный и квалифицированный ответ от нашего эксперта по вашему конкретному вопросу.
        </p>
        <ul class="hotline-promo-meta">
          <%
            const hotlineSource = stripHtmlTags(site.aboutAudience || site.hotlineText || '');
            const hotlineScheduleMatch = hotlineSource.match(/Каждый[^.]+/i)
              || hotlineSource.match(/(?:Пн|Вт|Ср|Чт|Пт|суббот|воскресен)[^.]*\d{1,2}:\d{2}[^.]*\d{1,2}:\d{2}/i);
            const hotlineSchedule = (hotlineScheduleMatch ? hotlineScheduleMatch[0] : 'Каждый вторник с 14:00 до 16:00').trim().replace(/\.$/, '');
          %>
          <li>
            <span class="hotline-promo-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
                <circle cx="12" cy="12" r="8.25" stroke="currentColor" stroke-width="1.7"/>
                <path d="M12 7.5V12l3 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span><%= hotlineSchedule %></span>
          </li>
          <li>
            <span class="hotline-promo-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
                <path d="M8.2 4.8h2.3l1.1 3.3-1.5 1.1a11.2 11.2 0 0 0 4.7 4.7l1.1-1.5 3.3 1.1v2.3c0 .7-.5 1.3-1.2 1.4A13.7 13.7 0 0 1 4.4 6c.1-.7.7-1.2 1.4-1.2Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
              </svg>
            </span>
            <span>
              Телефон:
              <% const hotlinePhone = site.phone2 || '+375 (29) 104 40 08'; %>
              <a class="text-link" href="tel:<%= hotlinePhone.replace(/[^\d+]/g, '') %>">
                <%= hotlinePhone %>
              </a>
            </span>
          </li>
          <li>
            <span class="hotline-promo-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
                <circle cx="12" cy="8" r="3.4" stroke="currentColor" stroke-width="1.7"/>
                <path d="M5.5 19.2c1.4-3 3.7-4.5 6.5-4.5s5.1 1.5 6.5 4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
              </svg>
            </span>
            <span>Эксперт: Коковкина Татьяна Валерьевна</span>
          </li>
        </ul>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer', { site }) %>
