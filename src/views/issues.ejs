<%- include('partials/head', { meta, site }) %>
<%- include('partials/header', { path, site }) %>
<%- include('partials/flash', { flash }) %>

<main class="section">
  <div class="shell page-head">
    <h1>Актуальные и архивные номера</h1>
  </div>

  <%
    const yearsMap = new Map();
    issues.forEach((issue) => {
      const year = parseIssueYear(issue.numberLabel, issue.publishDate) || 'Архив';
      if (!yearsMap.has(year)) {
        yearsMap.set(year, []);
      }
      yearsMap.get(year).push(issue);
    });
    const yearGroups = [...yearsMap.entries()].sort((left, right) => {
      const leftYear = Number(left[0]);
      const rightYear = Number(right[0]);
      if (Number.isFinite(leftYear) && Number.isFinite(rightYear)) {
        return rightYear - leftYear;
      }
      return String(right[0]).localeCompare(String(left[0]), 'ru');
    });
  %>

  <% yearGroups.forEach(([year, yearIssues]) => { %>
    <section class="shell issues-year-block">
      <h2 class="issues-year-title"><%= year %></h2>
      <div class="card-grid card-grid-issues">
        <% yearIssues.forEach((issue) => { %>
          <% const primaryMaterials = issue.materials.filter((material) => material.title && material.isPrimary).slice(0, 3); %>
          <% const previewMaterials = (primaryMaterials.length ? primaryMaterials : issue.materials.filter((material) => material.title)).slice(0, 3); %>
          <article class="issue-card issue-card-hover">
            <a class="issue-card-media" href="/issues/<%= issue.slug %>">
              <img src="<%= getCoverThumbPath(issue.coverImage) %>" alt="Обложка <%= issue.numberLabel %>" loading="lazy" decoding="async" />
              <div class="issue-card-overlay">
                <span class="issue-date"><%= formatIssuePeriod(issue) %></span>
                <h3><%= issue.numberLabel %></h3>
                <% if (previewMaterials.length) { %>
                  <p class="issue-overlay-label">Основные материалы</p>
                  <ul class="issue-material-list issue-material-list-compact">
                    <% previewMaterials.forEach((material) => { %>
                      <li><%= material.title %></li>
                    <% }) %>
                  </ul>
                <% } %>
              </div>
            </a>
          </article>
        <% }) %>
      </div>
    </section>
  <% }) %>
</main>

<%- include('partials/footer', { site }) %>
