<%
  const extras = page.extras || {};
  const extra = (key) => extras[key] || '';
  const readonlyInvoices = typeof invoicesOnly !== 'undefined' && invoicesOnly;
%>
<%- include('../partials/head', { meta, site }) %>
<main class="admin-layout">
  <%- include('../partials/admin-nav', { csrfToken }) %>
  <section class="admin-main">
    <%- include('../partials/flash', { flash }) %>
    <div class="admin-head">
      <div>
        <p class="eyebrow">Страница</p>
        <h1><%= readonlyInvoices ? 'Счета подписки' : page.title %></h1>
        <% if (readonlyInvoices) { %>
          <p class="form-note">Загрузка PDF-счетов для страницы подписки.</p>
        <% } %>
      </div>
    </div>

    <% if (!readonlyInvoices) { %>
    <form method="post" action="/admin/pages/<%= page.pageKey %>" class="admin-card stack-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <% if (page.pageKey === 'home') { %>
        <%- include('./partials/rich-field', { name: 'heroTitle', label: 'Hero-заголовок', value: formatRichHtml(extra('heroTitle')), placeholder: 'Заголовок на главной', rows: 2 }) %>
        <%- include('./partials/rich-field', { name: 'heroText', label: 'Hero-текст', value: formatRichHtml(extra('heroText')), placeholder: 'Текст под заголовком на главной', rows: 4 }) %>
        <label>SEO Title<input type="text" name="seoTitle" value="<%= extra('seoTitle') %>" /></label>
        <%- include('./partials/rich-field', { name: 'seoDescription', label: 'SEO Description', value: formatRichHtml(extra('seoDescription')), placeholder: '', rows: 3 }) %>
      <% } else { %>
        <label>Заголовок<input type="text" name="title" value="<%= page.title %>" required /></label>
        <% if (page.pageKey !== 'subscribe') { %>
          <%- include('./partials/rich-field', { name: 'lead', label: 'Лид', value: formatRichHtml(page.lead), placeholder: 'Краткий вводный текст страницы', rows: 3 }) %>
        <% } %>
      <% } %>

      <% if (page.pageKey === 'about') { %>
        <label>Периодичность<input type="text" name="periodicity" value="<%= extra('periodicity') %>" /></label>
        <%- include('./partials/rich-field', { name: 'distributionFormat', label: 'Формат распространения', value: formatRichHtml(extra('distributionFormat')), placeholder: '', rows: 3 }) %>
        <%- include('./partials/rich-field', { name: 'body', label: 'Основной текст', value: formatRichHtml(page.body), placeholder: 'Основной текст страницы', rows: 8 }) %>
        <label>SEO Title<input type="text" name="seoTitle" value="<%= extra('seoTitle') %>" placeholder="Если пусто — используется заголовок страницы" /></label>
        <%- include('./partials/rich-field', { name: 'seoDescription', label: 'SEO Description', value: formatRichHtml(extra('seoDescription')), placeholder: 'Если пусто — берётся лид или описание сайта', rows: 3 }) %>
      <% } else if (page.pageKey === 'contacts') { %>
        <label>Часы работы<input type="text" name="workingHours" value="<%= extra('workingHours') %>" /></label>
        <label>SEO Title<input type="text" name="seoTitle" value="<%= extra('seoTitle') %>" placeholder="Если пусто — Контакты" /></label>
        <%- include('./partials/rich-field', { name: 'seoDescription', label: 'SEO Description', value: formatRichHtml(extra('seoDescription')), placeholder: 'Если пусто — стандартное описание', rows: 3 }) %>
      <% } else if (page.pageKey === 'subscribe') { %>
        <%- include('./partials/rich-field', { name: 'lead', label: 'Вводный текст', value: formatRichHtml(page.lead), placeholder: 'Краткое описание в шапке страницы', rows: 3 }) %>
        <label>Подпись над каналами<input type="text" name="channelsLabel" value="<%= extra('channelsLabel') || 'Доступные каналы' %>" /></label>
        <label>Заголовок прямой подписки<input type="text" name="directTitle" value="<%= extra('directTitle') || 'Прямая подписка через редакцию' %>" /></label>
        <label>Шаг 1 — текст («Скачайте счёт…»)<input type="text" name="step1Text" value="<%= extra('step1Text') || 'Скачайте счёт на нужный период' %>" /></label>
        <label>Шаг 2 — текст («Или запросите счёт…»)<input type="text" name="step2Text" value="<%= extra('step2Text') || 'Или запросите счёт у менеджера' %>" /></label>
        <label>Примечание — жирный заголовок<input type="text" name="paymentNoteLabel" value="<%= extra('paymentNoteLabel') || 'В назначении платежа обязательно укажите:' %>" /></label>
        <label>Примечание — текст<textarea name="paymentNoteText" rows="2"><%= extra('paymentNoteText') || 'полный адрес доставки, контактный телефон и ваш e-mail.' %></textarea></label>
        <%- include('./partials/rich-field', { name: 'body', label: 'После оплаты', value: formatRichHtml(page.body), placeholder: 'Что делать после оплаты счёта', rows: 4 }) %>
        <label>Заголовок Белпочты<input type="text" name="belpochtaTitle" value="<%= extra('belpochtaTitle') || 'Подписка через РУП «Белпочта»' %>" /></label>
        <label>Подпись к индексам<input type="text" name="belpochtaIntro" value="<%= extra('belpochtaIntro') || 'Подписные индексы:' %>" /></label>
        <div class="form-grid-two">
          <label>Индекс 1 — название<input type="text" name="index1Label" value="<%= extra('index1Label') || 'ведомственная подписка' %>" /></label>
          <label>Индекс 1 — значение<input type="text" name="index1Value" value="<%= extra('index1Value') || '748512' %>" /></label>
          <label>Индекс 2 — название<input type="text" name="index2Label" value="<%= extra('index2Label') || 'индивидуальная подписка' %>" /></label>
          <label>Индекс 2 — значение<input type="text" name="index2Value" value="<%= extra('index2Value') || '74851' %>" /></label>
        </div>
        <label>Заголовок реквизитов<input type="text" name="requisitesTitle" value="<%= extra('requisitesTitle') || 'Реквизиты' %>" /></label>
        <label>Заголовок горячей линии<input type="text" name="hotlineTitle" value="<%= extra('hotlineTitle') || 'Горячая линия для подписчиков' %>" /></label>
        <div class="form-grid-two">
          <label>Эксперт<input type="text" name="hotlineExpert" value="<%= extra('hotlineExpert') || 'Коковкина Т.В.' %>" /></label>
          <label>Время<input type="text" name="hotlineSchedule" value="<%= extra('hotlineSchedule') || '' %>" placeholder="Если пусто — берётся из настроек" /></label>
        </div>
        <label>Текст под горячей линией<textarea name="hotlineNote" rows="3"><%= extra('hotlineNote') || 'Консультации для подписчиков, оформивших издание через РУП «Белпочта», предоставляются после предъявления документа, подтверждающего действующую подписку' %></textarea></label>
        <label>Подпись нижнего блока<input type="text" name="helpTitle" value="<%= extra('helpTitle') || 'Вопросы по подписке и доставке' %>" /></label>
        <label>SEO Title<input type="text" name="seoTitle" value="<%= extra('seoTitle') %>" placeholder="Если пусто — Подписка" /></label>
        <%- include('./partials/rich-field', { name: 'seoDescription', label: 'SEO Description', value: formatRichHtml(extra('seoDescription')), placeholder: 'Если пусто — стандартное описание', rows: 3 }) %>
        <p class="form-note">PDF-счета загружаются ниже. Телефоны — в разделе Настройки.</p>
      <% } %>

      <button class="button button-accent" type="submit">Сохранить</button>
    </form>
    <% } %>

    <% if (page.pageKey === 'subscribe') { %>
      <form method="post" action="/admin/pages/subscribe/invoice1" enctype="multipart/form-data" class="admin-card stack-form" style="margin-top: 1.5em;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <h2>Счет 1</h2>
        <p>Текущий файл: <%= extra('invoiceFile1') || 'не загружен' %></p>
        <label>Название кнопки
          <input type="text" name="invoiceLabel1" value="<%= extra('invoiceLabel1') || 'Скачать счет 1' %>" required />
        </label>
        <label>PDF-файл<input type="file" name="invoiceFile1" accept="application/pdf" /></label>
        <button class="button button-secondary" type="submit">Сохранить счет 1</button>
      </form>
      <form method="post" action="/admin/pages/subscribe/invoice2" enctype="multipart/form-data" class="admin-card stack-form" style="margin-top: 1.5em;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <h2>Счет 2</h2>
        <p>Текущий файл: <%= extra('invoiceFile2') || 'не загружен' %></p>
        <label>Название кнопки
          <input type="text" name="invoiceLabel2" value="<%= extra('invoiceLabel2') || 'Скачать счет 2' %>" required />
        </label>
        <label>PDF-файл<input type="file" name="invoiceFile2" accept="application/pdf" /></label>
        <button class="button button-secondary" type="submit">Сохранить счет 2</button>
      </form>
    <% } %>
  </section>
</main>
<script src="/scripts/main.js?v=<%= assetVersion %>" defer></script>
</body>
</html>
