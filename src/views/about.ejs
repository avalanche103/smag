<%- include('partials/head', { meta, site }) %>
<%- include('partials/header', { path, site }) %>
<%- include('partials/flash', { flash }) %>

<main class="section">
  <div class="shell about-layout">
    <div class="about-main">
      <div class="page-intro">
        <h1><%= page.title %></h1>
        <% if (page.lead) { %>
          <div class="lead rich-content"><%- formatRichHtml(page.lead) %></div>
        <% } %>
        <div class="rich-content"><%- formatRichHtml(page.body) %></div>
      </div>
      <div class="hero-actions">
        <a class="button button-accent" href="/subscribe">Оформить подписку</a>
      </div>
      <% if (featuredIssue?.coverImage) { %>
        <div class="about-cover">
          <img src="<%= featuredIssue.coverImage %>" alt="Обложка <%= featuredIssue.numberLabel %>" />
        </div>
      <% } %>
    </div>
    <div class="info-panel">
      <div>
        <h2>Рубрики</h2>
        <ul class="check-list">
          <li>Минстройархитектуры разъясняет</li>
          <li>Актуальный комментарий</li>
          <li>Вносим ясность</li>
          <li>Теория и практика учета</li>
          <li>Налогообложение в строительстве</li>
          <li>Ценообразование в строительстве</li>
          <li>Проверки в строительстве</li>
          <li>Юридическая помощь</li>
          <li>Судебная практика</li>
          <li>Вопрос-ответ</li>
        </ul>
      </div>
      <div>
        <h2>Для кого</h2>
        <% if (audienceTopics && audienceTopics.length) { %>
          <ul class="check-list">
            <% audienceTopics.forEach((topic) => { %>
              <li><%= topic %></li>
            <% }) %>
          </ul>
        <% } %>
      </div>
      <div>
        <h2>Периодичность</h2>
        <p><%= getPageExtra(page, 'periodicity') %></p>
      </div>
      <div>
        <h2>Издатель и редакция</h2>
        <p>ООО «Профессиональный диалог», УНП 193589657</p>
        <p>
          <% if (site.phone) { %><a href="tel:<%= site.phone %>"><%= site.phone %></a><% } %>
          <% if (site.phone && site.phone2) { %>, <% } %>
          <% if (site.phone2) { %><a href="tel:<%= site.phone2 %>"><%= site.phone2 %></a><% } %>
        </p>
        <p><a href="mailto:prof.dialogi@yandex.by">prof.dialogi@yandex.by</a></p>
      </div>
      <div>
        <h2>Формат распространения</h2>
        <p class="rich-content"><%- formatRichHtml(getPageExtra(page, 'distributionFormat')) %></p>
      </div>
      <a class="button button-accent" href="/subscribe">Узнать подробнее</a>
    </div>
  </div>
</main>

<%- include('partials/footer', { site }) %>
