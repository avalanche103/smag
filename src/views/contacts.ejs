<%- include('partials/head', { meta, site }) %>
<%- include('partials/header', { path, site }) %>
<%- include('partials/flash', { flash }) %>

<main class="section">
  <div class="shell contact-grid">
    <section class="contact-info">
      <h1><%= page.title %></h1>
      <% if (page.lead) { %>
        <div class="lead rich-content"><%- formatRichHtml(page.lead) %></div>
      <% } %>
      <ul class="contact-list">
        <% if (site.publisher) { %>
          <li><strong>Юрлицо:</strong> <%= stripHtmlTags(site.publisher) %></li>
        <% } %>
        <li><strong>Адрес:</strong> <%= site.address %></li>
        <li><strong>Email:</strong> <a href="mailto:<%= site.email %>"><%= site.email %></a></li>
        <% if (site.phone || site.phone2) { %>
          <li>
            <strong>Телефоны:</strong>
            <span class="contact-phones">
              <% if (site.phone) { %>
                <a href="tel:<%= site.phone %>"><%= site.phone %></a>
              <% } %>
              <% if (site.phone && site.phone2) { %>
                <span class="contact-phones-sep" aria-hidden="true">·</span>
              <% } %>
              <% if (site.phone2) { %>
                <a href="tel:<%= site.phone2 %>"><%= site.phone2 %></a>
              <% } %>
            </span>
          </li>
        <% } %>
        <% if (site.workingHours) { %>
          <li><strong>Часы работы:</strong> <%= site.workingHours %></li>
        <% } %>
      </ul>
    </section>
    <section class="form-card contact-form-card">
      <h2>Форма обратной связи</h2>
      <form method="post" action="/contacts" class="stack-form contact-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="text" name="website" class="honeypot" tabindex="-1" autocomplete="off" />
        <div class="contact-form-row">
          <label>
            Имя
            <input type="text" name="name" required />
          </label>
          <label>
            Телефон
            <input type="tel" name="phone" required />
          </label>
        </div>
        <label>
          Email
          <input type="email" name="email" required />
        </label>
        <label>
          Сообщение
          <textarea name="message" rows="3" required></textarea>
        </label>
        <label class="contact-captcha">
          Сколько будет <%= captchaQuestion %>?
          <input type="text" name="captcha" inputmode="numeric" autocomplete="off" required aria-describedby="contact-captcha-hint" />
        </label>
        <p id="contact-captcha-hint" class="contact-captcha-hint">Небольшая проверка, что вы не робот</p>
        <button class="button button-accent" type="submit">Отправить сообщение</button>
      </form>
    </section>
  </div>
</main>

<%- include('partials/footer', { site }) %>
