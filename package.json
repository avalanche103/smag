{
  "name": "smag-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site and custom CMS for the journal \"Строительство: Экономика, учет, право\"",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,ejs,css,js,json --exec ts-node --files src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:seed": "ts-node --files src/scripts/seed.ts",
    "backup": "ts-node --files src/scripts/backup.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "method-override": "^3.0.0",
    "multer": "^2.0.2",
    "nanoid": "^5.1.5",
    "read-excel-file": "^6.0.1",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.1",
    "@types/express-session": "^1.18.1",
    "@types/method-override": "^0.0.35",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.9",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2"
  }
}
